    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node lib/index.js",
    "start:dev": "yarn build && node lib/index.js"
  },
  "dependencies": {
    "config": "^5.0.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2",
    "matrix-bot-sdk": "^0.8.0",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
