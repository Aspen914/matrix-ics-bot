{
  "name": "matrix-ics-bot",
  "version": "0.2.0",
  "description": "A Matrix bot for scheduling recurring reminders from uploaded iCalendar (.ics) files.",
  "license": "Apache-2.0",
  "author": "TravisR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turt2live/matrix-ics-bot.git"
  },
  "bugs": {
    "url": "https://github.com/turt2live/matrix-ics-bot/issues"
  },
  "homepage": "https://github.com/turt2live/matrix-ics-bot#readme",
  "keywords": [
    "matrix",
    "bot",
    "ics",
    "icalendar",
    "reminders",
    "recurrence"
  ],
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
